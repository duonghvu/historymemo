/**
 * HistoryMemo: Google Apps Script backend. Everything is saved in YOUR Google Drive.
 * Files in this Apps Script project: Code.gs (this file) + Questions.gs (question bank).
 *
 * The journey for each storyteller (progress counts answers, not calendar days):
 *   1. 56 life questions (Questions.gs)                         → folders "Week 01 – Childhood" …
 *   2. Life timeline: questions generated by the Claude API,
 *      walking from birth → childhood → … → today, built on
 *      their earlier answers (transcripts)                      → folders "Timeline 2 – Childhood" …
 *   3. Ongoing diary (Questions.gs DIARY)                         → folders "Diary 2027-03" …
 *   Every story is logged in <user folder>/stories.json with a life stage, and "Make book" compiles
 *   a biography Google Doc ordered from family roots and birth up to today.
 *
 *  - Languages: en, vi, ja, teo (Teochew). Several languages rotate per day or per question.
 *  - Pace: 1, 2, 3 or 5 questions a day (reminders at local hours) + "answer one more now".
 *
 * Script properties (Project Settings → Script properties), optional:
 *   ANTHROPIC_API_KEY  → enables step 2 + AI-written book chapters   (CLAUDE_MODEL, default below)
 *   OPENAI_API_KEY     → enables automatic transcripts for en/vi/ja   (STT_MODEL, default whisper-1)
 * SETUP: README.md → Step 3.
 */

const CONFIG = {
  APP_URL: 'https://historymemo.vercel.app', // your Vercel URL (no trailing slash)
  ROOT_FOLDER: 'HistoryMemo',
  // MVP storage = one Google Drive owned by the family / company, organised by user.
  // Google Workspace? Put a Shared Drive ID here (from its URL: drive.google.com/drive/folders/<ID>).
  // Leave '' to use the script owner's My Drive (works with a free Gmail account).
  SHARED_DRIVE_ID: '0ALVZ7V3tp2XCUk9PVA',
  CLAUDE_MODEL: 'claude-sonnet-5',
  TIMELINE_PER_STAGE: 4, // generated questions per life stage
  // AI follow-up questions ("tell me more"): gentle, never more than this.
  FOLLOWUP_MAX_DEPTH: 2,   // at most 2 follow-ups on one story
  FOLLOWUPS_PER_DAY: 1,    // they take the place of a normal question, never an extra one
  PAUSE_AFTER_SKIPS: 2,    // this many skips in a row → no follow-ups for PAUSE_DAYS
  PAUSE_DAYS: 3,
  LOST_AFTER_DAYS: 7,      // an upload the phone never finished → marked lost (the question is asked again)
};

const LANGS = ['en', 'vi', 'ja', 'teo'];
const TEXT_LANGS = ['en', 'vi', 'ja'];        // languages with written questions + phone voices
const UI_LANGS = ['en', 'vi', 'ja'];
const MAX_SECONDS = 180;
const PER_DAY = [1, 2, 3, 5];
const DEFAULT_HOURS = { 1: [8], 2: [8, 19], 3: [8, 13, 19], 5: [8, 10, 13, 16, 19] };
// LIFE_TOTAL (56) lives in Questions.gs: Apps Script loads Code.gs first, so nothing here may use THEMES at load time.
const TIMELINE_STAGES = ['early', 'child', 'youth', 'young', 'middle', 'later', 'now'];
const STAGE_HINT = {
  early: 'birth and the very first memories (about age 0–6)',
  child: 'childhood (about age 7–12): home, school, games, family life',
  youth: 'teenage years: friends, school, first dreams, first independence',
  young: 'young adulthood (about 20–35): leaving home, first work, love, marriage, first child',
  middle: 'middle years (about 35–60): career, raising children, moves, hardships, achievements',
  later: 'later years (60+): retirement, grandchildren, health, what changed',
  now: 'life today: daily routines, what matters now, hopes',
};

const T = {
  en: { week: 'Week', timeline: 'Timeline', voice: 'Voice', video: 'Video', title: 'Story time 🎙️', newStory: n => `${n} just recorded a new story 🎉`, open: 'Open folder', listen: '▶ Listen / watch', index: 'Story index' },
  vi: { week: 'Tuần', timeline: 'Dòng đời', voice: 'Ghi âm', video: 'Video', title: '{X} ơi, kể chuyện nhé 🎙️', newStory: n => `${n} vừa kể chuyện mới 🎉`, open: 'Mở thư mục', listen: '▶ Nghe / xem', index: 'Mục lục câu chuyện' },
  ja: { week: '第', timeline: '年代記', voice: '音声', video: '動画', title: 'お話の時間です 🎙️', newStory: n => `${n}さんが新しいお話を録音しました 🎉`, open: 'フォルダを開く', listen: '▶ 聞く・見る', index: 'お話の目次' },
};
const BOOK = {
  en: { title: n => `The Life of ${n}`, sub: c => `${c} stories, told in their own voice · HistoryMemo` },
  vi: { title: n => `Chuyện đời ${n}`, sub: c => `${c} câu chuyện, kể bằng chính giọng nói · HistoryMemo` },
  ja: { title: n => `${n}の物語`, sub: c => `本人の声で語られた${c}のお話 · HistoryMemo` },
};
const FAMILY_NAME = { en: 'Family questions', vi: 'Con cháu hỏi', ja: '家族からの質問' };
const FOLLOW_NAME = { en: 'A little more', vi: 'Kể thêm', ja: 'もう少し' };
const REASON_LABEL = { again: 'family asked again', missing: 'recording missing' };
const SOURCE_LABEL = { life: 'Life questions', timeline: 'AI life timeline', diary: 'Diary', family: 'Family', followup: 'AI follow-up' };
const LANG_LABEL = { en: 'English', vi: 'Tiếng Việt', ja: '日本語', teo: 'Tiếng Tiều' };
const LANG_EN = { en: 'English', vi: 'Vietnamese', ja: 'Japanese', teo: 'Teochew' };

// ───────────────────────── one-time setup ─────────────────────────

function setup() {
  const props = PropertiesService.getScriptProperties();
  if (!props.getProperty('ROOT_ID')) {
    const parent = CONFIG.SHARED_DRIVE_ID ? DriveApp.getFolderById(CONFIG.SHARED_DRIVE_ID) : DriveApp;
    const root = parent.createFolder(CONFIG.ROOT_FOLDER);
    const prompts = root.createFolder('_Question voices');
    props.setProperties({
      ROOT_ID: root.getId(),
      PROMPTS_ID: prompts.getId(),
      SECRET: Utilities.getUuid().replace(/-/g, ''),
      ST_INDEX: '[]',
    });
  }
  ScriptApp.getProjectTriggers()
    .filter(t => t.getHandlerFunction() === 'hourly')
    .forEach(t => ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('hourly').timeBased().everyHours(1).create();

  Logger.log('✅ Drive folder: ' + DriveApp.getFolderById(prop_('ROOT_ID')).getUrl());
  Logger.log('✅ GAS_SECRET (put in Vercel env): ' + prop_('SECRET'));
  Logger.log('AI questions: ' + (prop_('ANTHROPIC_API_KEY') ? 'on' : 'off (add ANTHROPIC_API_KEY script property)'));
  Logger.log('Transcripts:  ' + (prop_('OPENAI_API_KEY') ? 'on' : 'off (add OPENAI_API_KEY script property)'));
  Logger.log('Next: Deploy → New deployment → Web app → Execute as: Me, Who has access: Anyone.');
}

// ───────────────────────── web API ─────────────────────────

function doGet() { return json_({ ok: true, app: 'historymemo' }); }

const READ_ONLY = { storytellers: 1, questions: 1, prompt: 1 };

function doPost(e) {
  let req;
  try { req = JSON.parse(e.postData.contents); } catch (err) { return json_({ error: 'bad json' }); }
  if (!req.secret || req.secret !== prop_('SECRET')) return json_({ error: 'unauthorized' });
  // Read-only admin screens don't queue behind slow work (creating a storyteller takes ~20 s).
  const lock = READ_ONLY[req.action] ? null : LockService.getScriptLock();
  if (lock && !lock.tryLock(45000)) return json_({ error: 'busy: HistoryMemo is finishing another task, please try again in a moment' });
  try {
    if (FATHER[req.action]) {
      const st = findByKey_(req.key);
      if (!st) return json_({ error: 'unauthorized' });
      return json_(FATHER[req.action](st, req));
    }
    if (ADMIN[req.action]) return json_(ADMIN[req.action](req));
    if (SERVER[req.action]) return json_(SERVER[req.action](req));
    return json_({ error: 'unknown action ' + req.action });
  } catch (err) {
    return json_({ error: String((err && err.message) || err) });
  } finally {
    if (lock) lock.releaseLock();
  }
}

// Actions for the storyteller's phone (authenticated by their private key)
const FATHER = {
  me(st) {
    const plan = ensureTimeline_(st);
    return { profile: publicProfile_(st), next: withAudio_(currentPrompt_(st, plan)),
             doneToday: doneToday_(st), rest: st.restDay === localDate_(st), maxSeconds: MAX_SECONDS };
  },

  saveProfile(st, req) {
    const p = req.profile || {};
    if (UI_LANGS.indexOf(p.uiLang) >= 0) st.uiLang = p.uiLang;
    if (Array.isArray(p.langs)) {
      const langs = p.langs.filter((l, i, a) => LANGS.indexOf(l) >= 0 && a.indexOf(l) === i);
      if (langs.length) st.langs = langs;
    }
    if (p.mode === 'daily' || p.mode === 'each') st.mode = p.mode;
    if (p.defaultKind === 'video' || p.defaultKind === 'audio') st.defaultKind = p.defaultKind;
    if (PER_DAY.indexOf(Number(p.perDay)) >= 0 && Number(p.perDay) !== st.perDay) {
      st.perDay = Number(p.perDay);
      st.hours = DEFAULT_HOURS[st.perDay].slice();
    }
    if (p.tz && /^[A-Za-z_]+\/[A-Za-z_\/+-]+$/.test(p.tz)) st.tz = p.tz;
    saveSt_(st);
    return FATHER.me(st);
  },

  // Before an upload. With `uid` (the phone's id for this recording) the server remembers which question it answers
  // and where it is going, so it can finish the story even if the phone never reports back (see checkUploads_).
  ticket(st, req) {
    const plan = readPlan_(st);
    const uid = req.uid ? cleanId_(req.uid).slice(0, 40) : '';
    const old = uid && plan.uploads[uid];
    const pr = old ? old.pr : resolvePrompt_(st, plan, req.qid);
    const t = T[st.uiLang || 'en'];
    const { folder } = storyFolder_(st, pr);
    const stamp = Utilities.formatDate(new Date(), st.tz, 'yyyy-MM-dd HHmm');
    const kind = req.kind === 'video' ? t.video : t.voice;
    const name = `${stamp} – ${LANG_LABEL[pr.lang]} – ${kind} – ${pr.display.slice(0, 60).trim()}.${safeExt_(req.ext)}`;
    if (uid) {
      plan.uploads[uid] = { pr, at: old ? old.at : Date.now(), date: old ? old.date : Utilities.formatDate(new Date(), st.tz, 'yyyy-MM-dd HH:mm'),
                            kind: req.kind === 'audio' ? 'audio' : 'video', size: Number(req.size) || 0, folderId: folder.getId(),
                            names: ((old && old.names) || []).concat([name]).slice(-5), tries: ((old && old.tries) || 0) + 1 };
      writeJson_(st, 'plan.json', plan);
    }
    return ticket_(folder.getId(), name);
  },

  // After the upload. Safe to call twice for the same recording (uid): the second call changes nothing.
  storyDone(st, req) {
    const plan = readPlan_(st);
    const uid = req.uid ? cleanId_(req.uid).slice(0, 40) : '';
    const stories = readJson_(st, 'stories.json', []);
    if (uid && stories.some(s => s.uid === uid)) {
      return { ok: true, duplicate: true, next: withAudio_(currentPrompt_(st, plan)), doneToday: doneToday_(st) };
    }
    let file;
    try { file = DriveApp.getFileById(req.fileId); } catch (err) { return { error: 'incomplete upload: file not in Drive', retry: true }; }
    if (Number(req.size) > 0 && file.getSize() < Number(req.size)) return { error: 'incomplete upload: file too small', retry: true };
    const up = uid && plan.uploads[uid];
    const pr = up ? up.pr : resolvePrompt_(st, plan, req.qid);
    const count = logStory_(st, plan, stories, pr, file, { uid, kind: req.kind, seconds: req.seconds, stage: req.stage });
    return { ok: true, next: withAudio_(currentPrompt_(st, ensureTimeline_(st))), doneToday: count };
  },

  // "Skip this question": never asked again (unless the family sets "Ask again" in the Sheet).
  skip(st, req) {
    const plan = readPlan_(st);
    const pr = resolvePrompt_(st, plan, req.qid);
    plan.skipped.push({ key: 'x' + rand_(), id: pr.id, src: pr.src || pr.phase, stage: pr.stage, phase: pr.phase,
                        seq: pr.seq, question: pr.text, lang: pr.lang, by: pr.by || '',
                        date: Utilities.formatDate(new Date(), st.tz, 'yyyy-MM-dd HH:mm') });
    if (pr.src) {
      plan.queue = plan.queue.filter(q => q.id !== pr.id && !(pr.src === 'followup' && q.root === pr.root));
    } else {
      st.progress = (st.progress || 0) + 1;
    }
    st.skips = (st.skips || 0) + 1;
    if (st.skips >= CONFIG.PAUSE_AFTER_SKIPS) {      // they're not in the mood: stop digging for a few days
      st.followPause = addDays_(st, CONFIG.PAUSE_DAYS);
      plan.queue = plan.queue.filter(q => q.src !== 'followup');
    }
    writeJson_(st, 'plan.json', plan);
    saveSt_(st);
    return { ok: true, next: withAudio_(currentPrompt_(st, ensureTimeline_(st))), doneToday: doneToday_(st) };
  },

  // "That's enough for today": no more questions or reminders until tomorrow.
  rest(st) {
    st.restDay = localDate_(st);
    saveSt_(st);
    return FATHER.me(st);
  },

  subscribe(st, req) {
    if (!req.sub || !req.sub.endpoint) return { error: 'no subscription' };
    st.subs = (st.subs || []).filter(s => s.endpoint !== req.sub.endpoint);
    st.subs.push(req.sub);
    st.subs = st.subs.slice(-5);
    saveSt_(st);
    return { ok: true };
  },
};

// Actions for the family admin page (the Vercel proxy checks admin login first)
const ADMIN = {
  storytellers() {
    return {
      ai: !!prop_('ANTHROPIC_API_KEY'), stt: !!prop_('OPENAI_API_KEY'),
      list: listSt_().map(st => {
        const plan = readPlan_(st);
        return { ...publicProfile_(st), key: st.key, family: st.family || [],
          subscribed: (st.subs || []).length, folderUrl: root_(st).getUrl(),
          stories: readJson_(st, 'stories.json', []).length, timeline: plan.timeline.length,
          timelineDone: plan.stageIdx >= TIMELINE_STAGES.length,
          phase: promptAt_(st, st.progress || 0, plan).phase,
          queued: plan.queue.length, skipped: plan.skipped.length,
          followUps: st.followUps !== false, followPause: st.followPause || '',
          sheetUrl: st.sheetId ? DriveApp.getFileById(st.sheetId).getUrl() : '',
          bookUrl: st.bookDocId ? DriveApp.getFileById(st.bookDocId).getUrl() : '' };
      }),
    };
  },

  createStoryteller(req) {
    const st = createSt_(req.fields || {});
    try { syncSheet_(st); } catch (err) { Logger.log('sheet: ' + err); }
    return { ok: true, id: st.id, key: st.key };
  },

  updateStoryteller(req) {
    const st = getSt_(req.id);
    if (!st) return { error: 'not found' };
    applyAdminFields_(st, req.fields || {});
    saveSt_(st);
    return { ok: true };
  },

  // Question list for recording question voices. With `id`, includes that person's generated timeline questions.
  questions(req) {
    const lang = LANGS.indexOf(req.lang) >= 0 ? req.lang : 'teo';
    const row = (id, group, q) => ({ id, group, en: q[0], vi: fillVi_(q[1], 'Ba'), ja: q[2], recorded: !!prop_(`P_${id}_${lang}`) });
    const list = [];
    THEMES.forEach((th, t) => th.q.forEach((q, d) => list.push(row(String(t * 7 + d), `${t + 1}. ${th.name.en}`, q))));
    const st = req.id && getSt_(req.id);
    if (st) {
      const plan = readPlan_(st);
      plan.queue.forEach(q => list.push(row(q.id, `Waiting for ${st.name}: family questions & follow-ups`, [q.en, q.vi, q.ja])));
      plan.timeline.forEach((q, k) =>
        list.push(row(timelineId_(st, k), `Life timeline (${st.name}): ${STAGE_NAME[q.stage].en}`, [q.en, q.vi, q.ja])));
    }
    DIARY.forEach((q, d) => list.push(row(String(LIFE_TOTAL + d), 'Diary (repeats)', q)));
    return { list, lang };
  },

  prompt(req) { return { data: promptData_(cleanId_(req.qid), req.lang) }; },

  promptTicket(req) {
    return ticket_(prop_('PROMPTS_ID'), `Q-${cleanId_(req.qid)}-${req.lang}.${safeExt_(req.ext)}`);
  },

  promptDone(req) {
    if (LANGS.indexOf(req.lang) < 0) return { error: 'bad lang' };
    const key = `P_${cleanId_(req.qid)}_${req.lang}`;
    const old = prop_(key);
    if (old && old !== req.fileId) { try { DriveApp.getFileById(old).setTrashed(true); } catch (err) {} }
    PropertiesService.getScriptProperties().setProperty(key, req.fileId);
    return { ok: true };
  },

  // Generate the next life-stage batch now (normally automatic near question 56)
  generateNow(req) {
    const st = getSt_(req.id);
    if (!st) return { error: 'not found' };
    if (!prop_('ANTHROPIC_API_KEY')) return { error: 'Add ANTHROPIC_API_KEY in Apps Script → Project Settings → Script properties' };
    const plan = readPlan_(st);
    if (plan.stageIdx >= TIMELINE_STAGES.length) return { error: 'All life stages already generated' };
    const added = generateStage_(st, plan);
    return { ok: true, added, stage: TIMELINE_STAGES[plan.stageIdx - 1], total: plan.timeline.length };
  },

  // Remove a storyteller (e.g. a duplicate). trash: true also moves their Drive folder to the trash (restorable ~30 days).
  deleteStoryteller(req) {
    const st = getSt_(req.id);
    if (!st) return { error: 'not found' };
    const ids = JSON.parse(prop_('ST_INDEX') || '[]').filter(id => id !== st.id);
    const props = PropertiesService.getScriptProperties();
    props.setProperty('ST_INDEX', JSON.stringify(ids));
    props.deleteProperty('ST_' + st.id);
    let trashed = false;
    if (req.trash) { try { root_(st).setTrashed(true); trashed = true; } catch (err) { Logger.log('trash: ' + err); } }
    return { ok: true, trashed };
  },

  // A family member asks a question from the admin page (same as typing it in the Sheet's "Add questions" tab).
  addQuestion(req) {
    const st = getSt_(req.id);
    if (!st) return { error: 'not found' };
    const text = String(req.text || '').trim().slice(0, 500);
    if (!text) return { error: 'empty question' };
    const ss = openSheet_(st);
    ss.getSheetByName(TAB_ADD).appendRow([text, req.stage || '', String(req.by || '').slice(0, 40), '', '']);
    syncSheet_(st);
    const rows = ss.getSheetByName(TAB_ADD).getDataRange().getValues();
    const last = rows[rows.length - 1];
    return { ok: true, id: last[4], status: last[3], sheetUrl: ss.getUrl() };
  },

  // Read family edits from the Sheet now (normally hourly) and rewrite the "All questions" tab.
  syncSheet(req) {
    const st = getSt_(req.id);
    if (!st) return { error: 'not found' };
    const out = syncSheet_(st);
    return { ok: true, ...out, sheetUrl: DriveApp.getFileById(getSt_(st.id).sheetId).getUrl() };
  },

  transcribeNow(req) {
    const st = getSt_(req.id);
    if (!st) return { error: 'not found' };
    if (!prop_('OPENAI_API_KEY')) return { error: 'Add OPENAI_API_KEY in Apps Script → Project Settings → Script properties' };
    return { ok: true, done: transcribePending_(st, 10) };
  },

  // Biography book (Google Doc), ordered by life stage: roots → born → … → today → messages.
  // write: true → Claude writes a short first-person chapter from the transcripts of each stage.
  buildBook(req) {
    const st = getSt_(req.id);
    if (!st) return { error: 'not found' };
    const ui = UI_LANGS.indexOf(req.lang) >= 0 ? req.lang : (st.uiLang || 'en');
    const stories = sortStories_(readJson_(st, 'stories.json', []).filter(s => !s.missing));
    const H = DocumentApp.ParagraphHeading;
    const doc = DocumentApp.create(BOOK[ui].title(st.name));
    const body = doc.getBody();
    body.appendParagraph(BOOK[ui].title(st.name)).setHeading(H.TITLE);
    body.appendParagraph(BOOK[ui].sub(stories.length));
    const write = req.write && prop_('ANTHROPIC_API_KEY');
    let chapters = 0;
    STAGES.forEach(stage => {
      const items = stories.filter(s => s.stage === stage);
      if (!items.length) return;
      body.appendParagraph(STAGE_NAME[stage][ui]).setHeading(H.HEADING1);
      const said = items.filter(s => s.transcript);
      if (write && said.length) {
        try { body.appendParagraph(writeChapter_(st, stage, said, ui)); chapters++; } catch (err) { Logger.log(err); }
      }
      items.forEach(s => {
        body.appendParagraph(s.question[ui] || s.question.en).setHeading(s.sub ? H.HEADING3 : H.HEADING2);
        if (TEXT_LANGS.indexOf(s.lang) >= 0 && s.lang !== ui) body.appendParagraph(s.question[s.lang]).setItalic(true);
        body.appendParagraph(`${s.date} · ${LANG_LABEL[s.lang]} · ${s.kind === 'video' ? T[ui].video : T[ui].voice} · ${mmss_(s.seconds)}`);
        body.appendListItem(T[ui].listen).setLinkUrl(s.url);
        if (s.transcript) body.appendParagraph(s.transcript);
      });
    });
    doc.saveAndClose();
    const file = DriveApp.getFileById(doc.getId());
    file.moveTo(root_(st));
    if (st.bookDocId && st.bookDocId !== doc.getId()) { try { DriveApp.getFileById(st.bookDocId).setTrashed(true); } catch (err) {} }
    st.bookDocId = doc.getId();
    saveSt_(st);
    return { ok: true, url: file.getUrl(), stories: stories.length, chapters };
  },

  testPush(req) {
    const st = getSt_(req.id);
    if (!st) return { error: 'not found' };
    return pushTo_(st);
  },
};

// Actions only the Vercel server calls itself (never proxied from a browser)
const SERVER = {
  // "Sign in with Google": the server has already verified the Google ID token.
  loginGoogle(req) {
    const email = String(req.email || '').toLowerCase();
    if (!/@/.test(email)) return { error: 'no email' };
    let st = listSt_().find(s => (s.email || '').toLowerCase() === email);
    if (!st) st = createSt_({ name: req.name || email.split('@')[0], email });
    return { key: st.key, profile: publicProfile_(st) };
  },
};

// ───────────────────────── question sequence ─────────────────────────

/**
 * The n-th question for a storyteller (n = number of stories already recorded):
 *   n < 56                → life question n
 *   then                  → generated life-timeline questions (birth → today)
 *   then                  → diary prompts, repeating
 * Language: mode "daily" → langs[day mod L]; mode "each" → langs[n mod L].
 */
function promptAt_(st, n, plan) {
  const ui = st.uiLang || 'en';
  let phase, id, seq, row, stage, theme, themeIndex = -1;
  if (n < LIFE_TOTAL) {
    phase = 'life'; seq = n; id = String(n);
    themeIndex = Math.floor(n / 7);
    row = THEMES[themeIndex].q[n % 7];
    stage = QUESTION_STAGE[n];
    theme = THEMES[themeIndex].name[ui];
  } else if (n - LIFE_TOTAL < plan.timeline.length) {
    seq = n - LIFE_TOTAL;
    const q = plan.timeline[seq];
    phase = 'timeline'; id = timelineId_(st, seq);
    row = [q.en, q.vi, q.ja];
    stage = q.stage;
    theme = STAGE_NAME[stage][ui];
  } else {
    seq = (n - LIFE_TOTAL - plan.timeline.length) % DIARY.length;
    phase = 'diary'; id = String(LIFE_TOTAL + seq);
    row = DIARY[seq];
    stage = DIARY_STAGE[seq];
    theme = DIARY_NAME[ui];
  }
  const langs = (st.langs && st.langs.length) ? st.langs : [ui];
  const base = st.mode === 'each' ? n : dayIndex_(st);
  const lang = langs[base % langs.length];
  const text = { en: row[0], vi: fillVi_(row[1], st.callName), ja: row[2] };
  return {
    n, id, phase, seq, themeIndex, stage, lang, theme, text,
    lifeTotal: LIFE_TOTAL,
    spoken: TEXT_LANGS.indexOf(lang) >= 0 ? text[lang] : null, // question in the answer language
    display: text[ui],                                          // question in the app language
  };
}

function withAudio_(p) {
  p.hasAudio = !!prop_(`P_${p.id}_${p.lang}`);
  if (p.hasAudio) p.audio = promptData_(p.id, p.lang);
  return p;
}

/**
 * plan.json:
 *   stageIdx, timeline  AI life-timeline questions (part of the fixed sequence, see promptAt_)
 *   queue               asked BEFORE the fixed sequence, in order: AI follow-ups (front) and family questions.
 *                       Each item: {id, src: 'family'|'followup', phase, seq, sub, root, stage, lang?, en, vi, ja, by, about, folder}
 *   skipped             questions the storyteller skipped (never asked again unless the family says "Ask again")
 *   uploads             recordings the phone started sending: {uid: {pr, at, names, folderId, size, lost?}}
 *   familySeq, fuDay    counters
 */
function emptyPlan_() { return { stageIdx: 0, timeline: [], queue: [], skipped: [], familySeq: 0, fuDay: {}, uploads: {} }; }
function readPlan_(st) { return Object.assign(emptyPlan_(), readJson_(st, 'plan.json', {})); }
function timelineId_(st, k) { return `t${st.id}_${k}`; }

/** What to ask now: the queue first (follow-ups, family questions), then the fixed sequence. */
function currentPrompt_(st, plan) {
  const q = (plan.queue || [])[0];
  return q ? queuePrompt_(st, q) : promptAt_(st, st.progress || 0, plan);
}

/** The prompt the phone was showing (by id), so a Sheet sync in between can't mix up questions. */
function resolvePrompt_(st, plan, qid) {
  if (qid) {
    const q = (plan.queue || []).find(x => x.id === qid);
    if (q) return queuePrompt_(st, q);
  }
  return currentPrompt_(st, plan);
}

function queuePrompt_(st, q) {
  const ui = st.uiLang || 'en';
  const langs = (st.langs && st.langs.length) ? st.langs : [ui];
  // A follow-up stays in the language they just answered in; a family question follows the rotation.
  const lang = q.lang && langs.indexOf(q.lang) >= 0 ? q.lang
    : langs[(st.mode === 'each' ? (st.progress || 0) + (st.extraDone || 0) : dayIndex_(st)) % langs.length];
  const text = { en: q.en, vi: fillVi_(q.vi, st.callName), ja: q.ja };
  return {
    n: st.progress || 0, id: q.id, phase: q.phase, seq: q.seq, sub: q.sub || 0, root: q.root || '', src: q.src,
    by: q.by || '', reason: q.reason || '', themeIndex: -1, stage: q.stage, lang, folder: q.folder || '',
    theme: (q.src === 'followup' ? FOLLOW_NAME : FAMILY_NAME)[ui], text,
    about: q.about ? (q.about[ui] || q.about.en) : '',
    lifeTotal: LIFE_TOTAL,
    spoken: TEXT_LANGS.indexOf(lang) >= 0 ? text[lang] : null,
    display: text[ui],
  };
}

/** Keep generated questions a few steps ahead once the 56 are nearly done. Never throws. */
function ensureTimeline_(st) {
  const plan = readPlan_(st);
  const progress = st.progress || 0;
  const ahead = LIFE_TOTAL + plan.timeline.length - progress;
  if (progress >= LIFE_TOTAL - 3 && ahead < 3 && plan.stageIdx < TIMELINE_STAGES.length && prop_('ANTHROPIC_API_KEY')) {
    try { generateStage_(st, plan); } catch (err) { Logger.log('generate failed: ' + err); }
  }
  return plan;
}

/** Ask Claude for the next life stage's questions, built on what the person has already told. */
function generateStage_(st, plan) {
  const stage = TIMELINE_STAGES[plan.stageIdx];
  const stories = readJson_(st, 'stories.json', []);
  const told = stories.filter(s => s.transcript).slice(-40)
    .map(s => `Q (${STAGE_NAME[s.stage].en}): ${s.question.en}\nA: ${s.transcript.slice(0, 600)}`).join('\n\n');
  const asked = THEMES.reduce((a, th) => a.concat(th.q.map(q => q[0])), [])
    .concat(plan.timeline.map(q => q.en)).join('\n');

  const system = 'You are a gentle oral-history interviewer helping an elderly person record their life story for their family. ' +
    'You write short, warm, concrete questions that are easy to answer by talking for 1–3 minutes.';
  const user = `Storyteller: ${st.name}. They answer in: ${(st.langs || []).map(l => LANG_EN[l]).join(', ')}.
Write ${CONFIG.TIMELINE_PER_STAGE} new questions about this life stage: ${STAGE_HINT[stage]}.
Go in chronological order within the stage. Build on details they already told (names, places, events) when you can.
Never repeat or closely rephrase an already-asked question. Avoid painful topics unless they raised them; keep it kind.

What they have told so far (may be empty or partial):
${told || '(no transcripts yet)'}

Already asked:
${asked}

Return ONLY a JSON array, no other text. Each item: {"en": "...", "vi": "...", "ja": "..."}
- vi: natural Vietnamese; address the person with the placeholder {X} at the start of a sentence and {x} elsewhere (it is replaced with the family's word for them, e.g. "Ba", "Mẹ"). No other pronouns for them.
- ja: polite です/ます style, warm, no name.`;
  const items = parseJsonArray_(claude_(system, user, 1500))
    .filter(q => q && q.en && q.vi && q.ja)
    .slice(0, CONFIG.TIMELINE_PER_STAGE)
    .map(q => ({ stage, en: String(q.en), vi: String(q.vi), ja: String(q.ja) }));
  plan.timeline = plan.timeline.concat(items);
  plan.stageIdx += 1;
  writeJson_(st, 'plan.json', plan);
  return items.length;
}

/** Claude writes a short first-person chapter for one life stage from the transcripts. */
function writeChapter_(st, stage, items, ui) {
  const text = items.map(s => `Q: ${s.question.en}\nA (${LANG_EN[s.lang]}): ${s.transcript}`).join('\n\n');
  return claude_(
    'You turn recorded oral-history answers into a short memoir chapter. Use only facts present in the answers; never invent.',
    `Write the "${STAGE_NAME[stage].en}" chapter of ${st.name}'s memoir in ${LANG_EN[ui]}, first person, warm and simple,
keeping their own expressions. 150–400 words, plain paragraphs, no headings.\n\n${text}`, 1200).trim();
}

function claude_(system, user, maxTokens) {
  const res = UrlFetchApp.fetch('https://api.anthropic.com/v1/messages', {
    method: 'post', contentType: 'application/json', muteHttpExceptions: true,
    headers: { 'x-api-key': prop_('ANTHROPIC_API_KEY'), 'anthropic-version': '2023-06-01' },
    payload: JSON.stringify({ model: prop_('CLAUDE_MODEL') || CONFIG.CLAUDE_MODEL, max_tokens: maxTokens || 1000,
                              system, messages: [{ role: 'user', content: user }] }),
  });
  const out = JSON.parse(res.getContentText());
  if (out.error) throw new Error('Claude API: ' + (out.error.message || JSON.stringify(out.error)));
  return (out.content || []).filter(c => c.type === 'text').map(c => c.text).join('');
}

function parseJsonArray_(text) {
  const m = String(text).match(/\[[\s\S]*\]/);
  try { return m ? JSON.parse(m[0]) : []; } catch (err) { return []; }
}

function parseJsonObject_(text) {
  const m = String(text).match(/\{[\s\S]*\}/);
  try { return m ? JSON.parse(m[0]) : null; } catch (err) { return null; }
}

const VI_RULE = '- vi: natural Vietnamese; address the person with the placeholder {X} at the start of a sentence and {x} elsewhere ' +
  '(it is replaced with the family\'s word for them, e.g. "Ba", "Mẹ"). No other pronouns for them.\n- ja: polite です/ます style, warm, no name.';

// ───────────────────────── AI follow-ups ("tell me a little more") ─────────────────────────

const FOLLOWUP_SYSTEM =
  'You are a warm oral-history interviewer helping an elderly person record their life story for their family. ' +
  'You use the tactical empathy of Chris Voss, adapted for a gentle family interview and never used to pressure: ' +
  'labels ("It sounds like…", "It seems…"), mirrors (softly repeating their last one to three important words), ' +
  'and calibrated open questions that begin with "What" or "How". ' +
  'You never ask "why" (it can feel like an accusation), never ask yes/no questions, and never ask two things at once. ' +
  'Asking nothing is often the kindest choice.';

/**
 * After a story is transcribed: decide whether ONE gentle follow-up would help them go deeper.
 * Limits keep it light: one follow-up waiting at a time, CONFIG.FOLLOWUPS_PER_DAY, CONFIG.FOLLOWUP_MAX_DEPTH per story,
 * paused after skips, and it takes the place of a normal question (it's never an extra one).
 * Returns 1 if a follow-up was queued.
 */
function followUps_(st) {
  if (st.followUps === false || !prop_('ANTHROPIC_API_KEY')) return 0;
  const today = localDate_(st);
  if (st.followPause && st.followPause > today) return 0;
  const plan = readPlan_(st);
  if (plan.queue.some(q => q.src === 'followup')) return 0;
  if ((plan.fuDay[today] || 0) >= CONFIG.FOLLOWUPS_PER_DAY) return 0;
  const stories = readJson_(st, 'stories.json', []);
  const s = stories[stories.length - 1];                        // only the latest story: memories are warm
  if (!s || s.followDone || s.transcriptStatus === 'pending') return 0;
  const mark = why => { s.followDone = why; writeJson_(st, 'stories.json', stories); return 0; };
  if (!s.transcript) return mark('no transcript');
  if ((s.sub || 0) >= CONFIG.FOLLOWUP_MAX_DEPTH) return mark('max depth');
  if (s.transcript.length < 40) return mark('short answer');
  if (daysBetween_(s.date.slice(0, 10), today) > 2) return mark('too old');

  const chain = stories.filter(x => x.root === s.root && x !== s)
    .map(x => `Q: ${x.question.en}\nA: ${(x.transcript || '(no transcript)').slice(0, 800)}`).join('\n\n');
  const user = `Storyteller: ${st.name}. They answered in ${LANG_EN[s.lang]}.
${chain ? `Earlier on this same memory:\n${chain}\n\n` : ''}Question they just answered: ${s.question.en}
Their answer (transcript, may contain recognition errors): ${s.transcript.slice(0, 3000)}

Decide whether ONE follow-up question would help them go deeper into this memory.
Ask only when the answer mentions something concrete they passed over quickly and the family would treasure:
a person, a place, a feeling, a turning point, a sensory detail.
Do NOT ask (return "ask": false) when:
- the answer already feels complete, or it is very short or vague ("I don't remember", "nothing special");
- they sound tired, sad or upset, or say they don't want to talk about it. Grief, war, illness, loss and family conflict
  are followed only if they clearly chose to open up, and then very gently;
- it would repeat something already asked above.
Shape: a short label or mirror, then one What/How question. Under 30 words in English. Warm, simple, spoken style, no pressure.

Return ONLY JSON: {"ask": true or false, "reason": "short reason", "technique": "label|mirror|calibrated", "en": "...", "vi": "...", "ja": "..."}
${VI_RULE}`;
  const out = parseJsonObject_(claude_(FOLLOWUP_SYSTEM, user, 600));
  if (!out || !out.ask || !out.en || !out.vi || !out.ja) return mark('not needed' + (out && out.reason ? ': ' + out.reason : ''));

  plan.queue.unshift({
    id: 'u' + rand_(), src: 'followup', phase: s.phase, seq: s.seq, sub: (s.sub || 0) + 1, root: s.root,
    stage: s.stage, lang: s.lang, en: String(out.en), vi: String(out.vi), ja: String(out.ja),
    technique: String(out.technique || ''), reason: String(out.reason || ''),
    about: { en: s.question.en, vi: s.question.vi, ja: s.question.ja }, folder: s.path.split('/')[0],
  });
  const count = (plan.fuDay[today] || 0) + 1;
  plan.fuDay = {}; plan.fuDay[today] = count;
  writeJson_(st, 'plan.json', plan);
  s.followDone = 'asked';
  writeJson_(st, 'stories.json', stories);
  return 1;
}

/** Run afterStory() in ~2 minutes (once), so a follow-up can be ready for the next question. */
function soon_() {
  try {
    if (ScriptApp.getProjectTriggers().some(t => t.getHandlerFunction() === 'afterStory')) return;
    ScriptApp.newTrigger('afterStory').timeBased().after(2 * 60 * 1000).create();
  } catch (err) { Logger.log('trigger: ' + err); }
}

function afterStory() {
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'afterStory').forEach(t => ScriptApp.deleteTrigger(t));
  listSt_().forEach(st => withLock_(() => {
    transcribePending_(getSt_(st.id) || st, 3);
    followUps_(getSt_(st.id) || st);
  }));
}

// ───────────────────────── logging a story + upload safety ─────────────────────────

/**
 * Save one story: stories.json, story index Doc, progress, family email. Used by storyDone and by checkUploads_
 * (a recording that reached Drive although the phone never reported back). Returns today's count.
 * The sequence only moves on if this question is still the one being asked, so a late duplicate never skips a question.
 */
function logStory_(st, plan, stories, pr, file, o) {
  const ui = st.uiLang || 'en';
  const t = T[ui];
  const stamp = Utilities.formatDate(new Date(), st.tz, 'yyyy-MM-dd HH:mm');
  const stage = STAGES.indexOf(o.stage) >= 0 ? o.stage : pr.stage;
  const kind = o.kind === 'audio' ? 'audio' : 'video';
  stories.push({
    n: pr.n, id: pr.id, phase: pr.phase, seq: pr.seq, stage, lang: pr.lang,
    kind, seconds: Math.round(o.seconds || 0),
    date: stamp, question: pr.text, fileId: file.getId(), url: file.getUrl(),
    path: `${storyFolder_(st, pr).name}/${file.getName()}`,
    transcript: '', transcriptStatus: TEXT_LANGS.indexOf(pr.lang) >= 0 ? 'pending' : 'unsupported',
    src: pr.src || pr.phase, sub: pr.sub || 0, root: pr.root || file.getId(), by: pr.by || '',
    uid: o.uid || '', recovered: !!o.recovered,
  });
  writeJson_(st, 'stories.json', stories);

  if (pr.src) {                                   // a family question or follow-up from the queue
    const before = plan.queue.length;
    plan.queue = plan.queue.filter(q => q.id !== pr.id);
    if (plan.queue.length < before) st.extraDone = (st.extraDone || 0) + 1;
  } else if ((pr.n || 0) === (st.progress || 0)) {
    st.progress = (st.progress || 0) + 1;
  }
  if (o.uid) delete plan.uploads[o.uid];
  writeJson_(st, 'plan.json', plan);

  const doc = DocumentApp.openById(st.indexDocId);
  const body = doc.getBody();
  body.appendParagraph(`${stamp} · ${pr.theme} · ${LANG_LABEL[pr.lang]} · ${kind === 'video' ? t.video : t.voice}`)
    .setHeading(DocumentApp.ParagraphHeading.HEADING3);
  body.appendParagraph(pr.display).setItalic(true);
  body.appendListItem(`${t.listen} (${Math.round(o.seconds || 0)}s)`).setLinkUrl(file.getUrl());
  doc.saveAndClose();

  if (!o.recovered) st.skips = 0;
  const date = localDate_(st);
  const count = doneToday_(st, date) + 1;
  st.answered = {}; st.answered[date] = count;
  saveSt_(st);
  soon_(); // transcribe + think about a follow-up in a couple of minutes, while the memory is warm

  if (st.family && st.family.length) {
    MailApp.sendEmail({
      to: st.family.join(','),
      subject: `${t.newStory(st.name)} · ${pr.display}`,
      htmlBody: `<p style="font-size:18px"><b>${pr.display}</b> <i>(${LANG_LABEL[pr.lang]})</i></p>
        <p><a href="${file.getUrl()}">${t.listen}</a></p>
        <p><a href="${root_(st).getUrl()}">${t.open}: ${st.name}</a></p>`,
    });
  }
  return count;
}

/**
 * Uploads the phone started (ticket with uid) but never confirmed:
 *  - the file is in Drive → finish the story here ("recovered"), so nothing is lost if the phone died after uploading;
 *  - nothing after CONFIG.LOST_AFTER_DAYS → marked lost. The question was never counted as answered,
 *    so it simply stays in the plan and is asked again.
 */
function checkUploads_(st) {
  const plan = readPlan_(st);
  const now = Date.now(), HOUR = 3600 * 1000, DAY = 24 * HOUR;
  let changed = false, recovered = 0;
  Object.keys(plan.uploads).forEach(uid => {
    const u = plan.uploads[uid];
    if (u.lost) { if (now - u.at > 30 * DAY) { delete plan.uploads[uid]; changed = true; } return; }
    if (now - u.at < HOUR) return;                       // the phone is probably still busy with it
    const file = findUpload_(u);
    if (file) {
      const stories = readJson_(st, 'stories.json', []);
      if (stories.some(s => s.uid === uid)) { delete plan.uploads[uid]; changed = true; return; }
      logStory_(st, plan, stories, u.pr, file, { uid, kind: u.kind, seconds: 0, recovered: true });
      st = getSt_(st.id) || st;
      recovered++;
      return;
    }
    if (now - u.at > CONFIG.LOST_AFTER_DAYS * DAY) { u.lost = localDate_(st); changed = true; }
  });
  if (changed) writeJson_(st, 'plan.json', plan);
  return recovered;
}

function findUpload_(u) {
  try {
    const folder = DriveApp.getFolderById(u.folderId);
    for (const name of u.names || []) {
      const it = folder.getFilesByName(name);
      while (it.hasNext()) { const f = it.next(); if (f.getSize() > 0 && (!u.size || f.getSize() >= u.size)) return f; }
    }
  } catch (err) { Logger.log('findUpload: ' + err); }
  return null;
}

/** Once a day: a recording that disappeared from Drive (deleted, trashed, empty) → ask that question again. */
function checkFiles_(st) {
  const stories = readJson_(st, 'stories.json', []);
  const plan = readPlan_(st);
  let missing = 0;
  stories.forEach(s => {
    if (s.missing) return;
    let ok;
    try { const f = DriveApp.getFileById(s.fileId); ok = !f.isTrashed() && f.getSize() > 0; } catch (err) { ok = false; }
    if (ok) return;
    s.missing = localDate_(st);
    missing++;
    if (plan.queue.some(q => q.missingOf === s.fileId)) return;
    plan.queue.push({ id: 'm' + rand_(), src: 'family', reason: 'missing', missingOf: s.fileId, phase: s.phase, seq: s.seq,
                      sub: s.sub || 0, root: s.root, stage: s.stage, lang: s.lang,
                      en: s.question.en, vi: s.question.vi, ja: s.question.ja });
  });
  if (missing) { writeJson_(st, 'stories.json', stories); writeJson_(st, 'plan.json', plan); }
  return missing;
}

// ───────────────────────── question Sheet (Google Sheets) ─────────────────────────
// One Sheet per storyteller, in their Drive folder, shared with the family as editors:
//   "Add questions"  the family types new questions (any language) → translated, checked for repeats, queued
//   "All questions"  rewritten by HistoryMemo: what's next, what was answered (with recording + transcript),
//                    what was skipped, what's coming. Family can edit Transcript, or type "Ask again" in Status.

const TAB_ADD = 'Add questions';
const TAB_ALL = 'All questions';
const ADD_HEAD = ['Question (type in any language)', 'Life stage (optional)', 'Asked by', 'Status (HistoryMemo fills this in)', 'ID'];
const ALL_HEAD = ['Key', 'Status (type "Ask again" to re-ask)', 'Source', 'Life stage', 'English', 'Tiếng Việt', '日本語',
                  'Asked on', 'Answer language', 'Recording', 'Transcript (you can edit or type it)', 'Notes'];
const ASK_AGAIN = 'ask again';

function openSheet_(st) {
  if (st.sheetId) { try { return SpreadsheetApp.openById(st.sheetId); } catch (err) { Logger.log('sheet missing, recreating: ' + err); } }
  const ss = SpreadsheetApp.create(`Questions – ${st.name}`);
  const add = ss.getSheets()[0];
  add.setName(TAB_ADD);
  add.getRange(1, 1, 1, ADD_HEAD.length).setValues([ADD_HEAD]);
  add.setFrozenRows(1);
  const all = ss.insertSheet(TAB_ALL);
  all.getRange(1, 1, 1, ALL_HEAD.length).setValues([ALL_HEAD]);
  all.setFrozenRows(1);
  const file = DriveApp.getFileById(ss.getId());
  file.moveTo(root_(st));
  (st.family || []).forEach(email => { try { file.addEditor(email); } catch (err) {} });
  st.sheetId = ss.getId();
  saveSt_(st);
  return ss;
}

/** Read the family's edits, queue new questions, then rewrite "All questions". Returns counts. */
function syncSheet_(st) {
  const ss = openSheet_(st);
  st = getSt_(st.id) || st;
  const plan = readPlan_(st);
  const stories = readJson_(st, 'stories.json', []);
  let added = 0, again = 0, typed = 0;

  // 1. "All questions": typed/edited transcripts and "Ask again"
  const all = ss.getSheetByName(TAB_ALL);
  all.getDataRange().getValues().slice(1).forEach(r => {
    const key = String(r[0] || ''), status = String(r[1] || '').trim().toLowerCase(), text = String(r[10] || '').trim();
    const s = stories.find(x => x.fileId === key);
    if (s && text && text !== (s.transcript || '')) { s.transcript = text; s.transcriptStatus = 'done'; s.typed = true; typed++; }
    if (status !== ASK_AGAIN) return;
    const skip = plan.skipped.find(x => x.key === key);
    const src = s || skip;
    if (!src || plan.queue.some(q => q.again === key)) return;
    plan.queue.push({ id: 'a' + rand_(), src: 'family', again: key, phase: src.phase || 'family', seq: src.seq || 0, sub: 0,
                      stage: src.stage, en: src.question.en, vi: src.question.vi, ja: src.question.ja, reason: 'again' });
    again++;
  });

  // 2. "Add questions": new rows (no ID yet)
  const add = ss.getSheetByName(TAB_ADD);
  const rows = add.getDataRange().getValues();
  for (let i = 1; i < rows.length; i++) {
    const text = String(rows[i][0] || '').trim();
    if (!text || String(rows[i][4] || '').trim()) continue;
    const res = addFamilyQuestion_(st, plan, stories, text, String(rows[i][1] || ''), String(rows[i][2] || ''));
    add.getRange(i + 1, 4, 1, 2).setValues([[res.status, res.id]]);
    rows[i][3] = res.status; rows[i][4] = res.id;
    added++;
  }

  if (added || again) writeJson_(st, 'plan.json', plan);
  if (typed) writeJson_(st, 'stories.json', stories);

  // 3. refresh statuses on "Add questions" and rewrite "All questions"
  const current = currentPrompt_(st, plan);
  for (let i = 1; i < rows.length; i++) {
    const id = String(rows[i][4] || '');
    if (!id || /^Already/.test(String(rows[i][3]))) continue;
    const status = statusOf_(id, plan, stories, current);
    if (status !== rows[i][3]) add.getRange(i + 1, 4).setValue(status);
  }
  const table = sheetRows_(st, plan, stories, current);
  all.clearContents();
  all.getRange(1, 1, table.length, ALL_HEAD.length).setValues(table);
  return { added, again, typed, rows: table.length - 1 };
}

function statusOf_(id, plan, stories, current) {
  const done = stories.filter(s => s.id === id);
  if (done.length) return `Answered ${done[done.length - 1].date}`;
  if (plan.skipped.some(x => x.id === id)) return 'Skipped';
  if (current.id === id) return 'Next';
  const i = plan.queue.findIndex(q => q.id === id);
  return i >= 0 ? `Queued (#${i + 1})` : 'Not asked yet';
}

/** Rows for "All questions": next + queued, answered and skipped (newest first), then the questions still to come. */
function sheetRows_(st, plan, stories, current) {
  const stage = s => (STAGE_NAME[s] || {}).en || s || '';
  const vi = q => fillVi_(q.vi || '', st.callName);
  const out = [ALL_HEAD];
  plan.queue.forEach((q, i) => out.push([q.id, i === 0 ? 'Next' : `Queued (#${i + 1})`,
    q.src === 'followup' ? SOURCE_LABEL.followup : q.reason ? `Re-ask (${REASON_LABEL[q.reason] || q.reason})` : `${SOURCE_LABEL.family}${q.by ? ': ' + q.by : ''}`,
    stage(q.stage), q.en, vi(q), q.ja, '', '', '', '',
    q.src === 'followup' ? `About: ${(q.about || {}).en || ''}${q.reason ? ' · ' + q.reason : ''}` : '']));
  if (!plan.queue.length) out.push([current.id, 'Next', SOURCE_LABEL[current.phase], stage(current.stage),
    current.text.en, current.text.vi, current.text.ja, '', '', '', '', '']);

  const log = stories.map(s => ({ s, date: s.date })).concat(plan.skipped.map(x => ({ x, date: x.date })))
    .sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
  log.forEach(({ s, x }) => {
    if (s) {
      out.push([s.fileId, s.missing ? 'Missing in Drive' : 'Answered', SOURCE_LABEL[s.src || s.phase] + (s.by ? ': ' + s.by : ''), stage(s.stage),
        s.question.en, s.question.vi, s.question.ja, s.date, LANG_LABEL[s.lang] || s.lang, s.url, s.transcript || '',
        s.missing ? `recording gone since ${s.missing}: asking again` : s.recovered ? 'phone lost touch; recovered from Drive' :
        s.transcript ? (s.typed ? 'typed by family' : '') : ({ pending: 'transcript coming', unsupported: 'Teochew: please type it' }[s.transcriptStatus] || s.transcriptStatus || '')]);
    } else {
      out.push([x.key, 'Skipped', SOURCE_LABEL[x.src] || x.src, stage(x.stage), x.question.en, x.question.vi, x.question.ja,
        x.date, LANG_LABEL[x.lang] || '', '', '', 'not asked again unless you type "Ask again"']);
    }
  });

  Object.keys(plan.uploads).forEach(uid => {
    const u = plan.uploads[uid], p = u.pr;
    out.push([uid, u.lost ? 'Lost on the phone' : 'Still on the phone', SOURCE_LABEL[p.src || p.phase] || '', stage(p.stage),
      p.text.en, p.text.vi, p.text.ja, u.date || '', LANG_LABEL[p.lang] || '', '', '',
      u.lost ? 'never arrived: the question stays in the plan and will be asked again'
             : `recorded, not sent yet (${u.tries} tries): the phone finishes it next time the app opens`]);
  });

  const asked = {}; stories.forEach(s => (asked[s.id] = 1)); plan.skipped.forEach(x => (asked[x.id] = 1));
  for (let n = (st.progress || 0) + 1; n < LIFE_TOTAL + plan.timeline.length; n++) {
    const p = promptAt_(st, n, plan);
    if (asked[p.id] || p.id === current.id) continue;
    out.push([p.id, 'Not asked yet', SOURCE_LABEL[p.phase], stage(p.stage), p.text.en, p.text.vi, p.text.ja, '', '', '', '', '']);
  }
  return out;
}

/** Translate a family question into en/vi/ja, pick its life stage, and catch repeats. */
function addFamilyQuestion_(st, plan, stories, text, stageIn, by) {
  const id = 'f' + rand_();
  const known = knownQuestions_(st, plan, stories);
  const tr = translateQuestion_(st, text, known);
  const dup = tr.duplicateOf && known.find(k => k.id === String(tr.duplicateOf));
  if (dup) {
    const done = stories.filter(s => s.id === dup.id).pop();
    return { id, status: done ? `Already answered ${done.date}: "${dup.en}" (type "Ask again" on "All questions" to re-ask)`
                              : `Already planned: "${dup.en}"` };
  }
  const want = String(stageIn || '').trim().toLowerCase();
  const stage = STAGES.find(s => s === want || STAGE_NAME[s].en.toLowerCase() === want) ||
                (STAGES.indexOf(tr.stage) >= 0 ? tr.stage : 'now');
  plan.familySeq = (plan.familySeq || 0) + 1;
  plan.queue.push({ id, src: 'family', phase: 'family', seq: plan.familySeq, sub: 0, stage,
                    en: tr.en, vi: tr.vi, ja: tr.ja, by: String(by || '').slice(0, 40), original: text });
  return { id, status: 'Queued' };
}

function knownQuestions_(st, plan, stories) {
  const list = [];
  THEMES.forEach((th, t) => th.q.forEach((q, d) => list.push({ id: String(t * 7 + d), en: q[0] })));
  plan.timeline.forEach((q, k) => list.push({ id: timelineId_(st, k), en: q.en }));
  plan.queue.forEach(q => list.push({ id: q.id, en: q.en }));
  stories.filter(s => s.src === 'family' || s.src === 'followup').forEach(s => list.push({ id: s.id, en: s.question.en }));
  return list;
}

function translateQuestion_(st, text, known) {
  const norm = s => String(s).toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
  if (prop_('ANTHROPIC_API_KEY')) {
    try {
      const out = parseJsonObject_(claude_(
        'You translate interview questions that a family wants to ask an elderly relative, and you spot repeated questions.',
        `A family member wants to ask ${st.name} this question (it may be written in any language):
"""${text}"""

Translate it into natural spoken English, Vietnamese and Japanese for an elderly person. Keep the meaning and the family's
intent; you may smooth the wording so it is warm and easy to answer by talking for a minute or two.
Pick the life stage it is about: ${STAGES.map(s => `${s} (${STAGE_NAME[s].en})`).join(', ')}.
If it asks essentially the same thing as one of the questions below, put that question's id in "duplicateOf", else "".

Questions already asked or planned (id: English):
${known.map(k => `${k.id}: ${k.en}`).join('\n')}

Return ONLY JSON: {"en": "...", "vi": "...", "ja": "...", "stage": "...", "duplicateOf": ""}
${VI_RULE}`, 800));
      if (out && out.en && out.vi && out.ja) return out;
    } catch (err) { Logger.log('translate: ' + err); }
  }
  // No AI key (or it failed): Google Translate, exact-repeat check only.
  const tr = lang => { try { return LanguageApp.translate(text, '', lang); } catch (err) { return text; } };
  const en = tr('en');
  const dup = known.find(k => norm(k.en) === norm(en));
  return { en, vi: tr('vi'), ja: tr('ja'), stage: '', duplicateOf: dup ? dup.id : '' };
}

function withLock_(fn) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) { Logger.log('busy, skipped this round'); return; }
  try { return fn(); } catch (err) { Logger.log(err); } finally { lock.releaseLock(); }
}

/** Speech-to-text for en/vi/ja recordings (Teochew is not supported by current STT models). */
function transcribePending_(st, max) {
  const key = prop_('OPENAI_API_KEY');
  if (!key) return 0;
  const stories = readJson_(st, 'stories.json', []);
  let done = 0;
  for (const s of stories) {
    if (done >= max) break;
    if (s.transcriptStatus !== 'pending') continue;
    try {
      const blob = DriveApp.getFileById(s.fileId).getBlob();
      if (blob.getBytes().length > 24 * 1024 * 1024) { s.transcriptStatus = 'too-large'; continue; }
      const res = UrlFetchApp.fetch('https://api.openai.com/v1/audio/transcriptions', {
        method: 'post', muteHttpExceptions: true, headers: { Authorization: 'Bearer ' + key },
        payload: { file: blob, model: prop_('STT_MODEL') || 'whisper-1', language: s.lang },
      });
      const out = JSON.parse(res.getContentText());
      if (out.text !== undefined) { s.transcript = String(out.text).trim(); s.transcriptStatus = 'done'; }
      else s.transcriptStatus = 'error';
    } catch (err) { s.transcriptStatus = 'error'; }
    done++;
  }
  if (done) writeJson_(st, 'stories.json', stories);
  return done;
}

// ───────────────────────── hourly: reminders + transcripts ─────────────────────────

function hourly() {
  listSt_().forEach(st => withLock_(() => {
    // Before the reminder: unfinished uploads → transcripts → maybe a follow-up → family questions from the Sheet.
    try { checkUploads_(getSt_(st.id) || st); } catch (err) { Logger.log(`uploads ${st.id}: ${err}`); }
    if (Number(Utilities.formatDate(new Date(), st.tz, 'H')) === 3) {
      try { checkFiles_(getSt_(st.id) || st); } catch (err) { Logger.log(`files ${st.id}: ${err}`); }
    }
    transcribePending_(getSt_(st.id) || st, 5);
    try { followUps_(getSt_(st.id) || st); } catch (err) { Logger.log(`follow-up ${st.id}: ${err}`); }
    try { syncSheet_(getSt_(st.id) || st); } catch (err) { Logger.log(`sheet ${st.id}: ${err}`); }
    st = getSt_(st.id) || st;
    if (st.langs && st.langs.length && (st.subs || []).length) {
      const hour = Number(Utilities.formatDate(new Date(), st.tz, 'H'));
      const date = localDate_(st);
      const slot = (st.hours || []).slice(0, st.perDay).indexOf(hour);
      const sent = (st.sent || {})[date] || [];
      // remind at the slot-th hour only if they haven't already answered that many today, and didn't say "enough"
      if (slot >= 0 && sent.indexOf(slot) < 0 && doneToday_(st, date) <= slot && st.restDay !== date) {
        pushTo_(st);
        const fresh = getSt_(st.id) || st;
        fresh.sent = {}; fresh.sent[date] = sent.concat([slot]);
        saveSt_(fresh);
      }
    }
  }));
}

function pushTo_(st) {
  if (!(st.subs || []).length) return { ok: false, error: 'This phone has not turned on notifications yet' };
  const pr = currentPrompt_(st, readPlan_(st));
  const payload = { title: fillVi_(T[st.uiLang || 'en'].title, st.callName), body: pr.display, url: '/' };
  const res = UrlFetchApp.fetch(CONFIG.APP_URL + '/api/push', {
    method: 'post', contentType: 'application/json', muteHttpExceptions: true,
    payload: JSON.stringify({ secret: prop_('SECRET'), subs: st.subs, payload }),
  });
  let out = {};
  try { out = JSON.parse(res.getContentText()); } catch (err) { out = { error: res.getContentText().slice(0, 200) }; }
  if (out.gone && out.gone.length) {
    st.subs = st.subs.filter(s => out.gone.indexOf(s.endpoint) < 0);
    saveSt_(st);
  }
  return { ok: !out.error, sent: out.sent || 0, error: out.error };
}

// ───────────────────────── storage helpers ─────────────────────────

/** Folder for a story: "Week 03 – Hometown", "Timeline 2 – Childhood", "Diary 2027-01". */
function storyFolder_(st, pr) {
  const ui = st.uiLang || 'en';
  const t = T[ui];
  const name = pr.folder ? pr.folder                         // follow-up: next to the story it continues
    : pr.phase === 'family' ? FAMILY_NAME[ui]
    : pr.phase === 'life'
    ? `${t.week} ${String(pr.themeIndex + 1).padStart(2, '0')} – ${THEMES[pr.themeIndex].name[ui]}`
    : pr.phase === 'timeline'
      ? `${t.timeline} ${TIMELINE_STAGES.indexOf(pr.stage) + 1} – ${STAGE_NAME[pr.stage][ui]}`
      : `${DIARY_NAME[ui]} ${Utilities.formatDate(new Date(), st.tz, 'yyyy-MM')}`;
  const root = root_(st);
  const it = root.getFoldersByName(name);
  return { folder: it.hasNext() ? it.next() : root.createFolder(name), name };
}

/**
 * Biography order: life stage (roots → … → now → legacy), then life → family → timeline → diary, then sequence,
 * then date. A follow-up has its parent's phase + seq, so it lands right after the story it continues.
 * tools/video-book.mjs loads this same function.
 */
function sortStories_(list) {
  const P = { life: 0, family: 1, timeline: 2, diary: 3 };
  return list.slice().sort((a, b) =>
    (STAGES.indexOf(a.stage) - STAGES.indexOf(b.stage)) ||
    (P[a.phase] - P[b.phase]) ||
    (a.phase !== 'diary' ? a.seq - b.seq : 0) ||
    (a.date < b.date ? -1 : a.date > b.date ? 1 : 0) ||
    ((a.sub || 0) - (b.sub || 0)));
}

function readJson_(st, name, fallback) {
  const it = root_(st).getFilesByName(name);
  if (!it.hasNext()) return fallback;
  try { return JSON.parse(it.next().getBlob().getDataAsString()); } catch (err) { return fallback; }
}

function writeJson_(st, name, data) {
  const root = root_(st);
  const it = root.getFilesByName(name);
  const json = JSON.stringify(data, null, 1);
  if (it.hasNext()) it.next().setContent(json);
  else root.createFile(name, json, 'application/json');
}

function createSt_(f) {
  const id = 's' + Utilities.getUuid().replace(/-/g, '').slice(0, 8);
  const name = String(f.name || 'Ba').slice(0, 40);
  // Drive is organised by user: HistoryMemo / <name> (<id>) / Week 01 – Childhood / ...
  const folder = DriveApp.getFolderById(prop_('ROOT_ID')).createFolder(`${name} (${id})`);
  const uiLang = UI_LANGS.indexOf(f.uiLang) >= 0 ? f.uiLang : '';
  const doc = DocumentApp.create(`${T[uiLang || 'en'].index} – ${name}`);
  doc.getBody().appendParagraph(name).setHeading(DocumentApp.ParagraphHeading.TITLE);
  doc.saveAndClose();
  DriveApp.getFileById(doc.getId()).moveTo(folder);

  const st = {
    id, key: Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, '').slice(0, 8),
    name, callName: String(f.callName || name).slice(0, 20), email: '',
    uiLang, langs: [], mode: 'daily', perDay: 1, hours: DEFAULT_HOURS[1].slice(), defaultKind: 'video',
    tz: f.tz && validTz_(String(f.tz).trim()) ? String(f.tz).trim() : Session.getScriptTimeZone(), start: '', progress: 0,
    folderId: folder.getId(), indexDocId: doc.getId(),
    family: [], subs: [], answered: {}, sent: {},
  };
  applyAdminFields_(st, f);
  st.start = localDate_(st);
  const ids = JSON.parse(prop_('ST_INDEX') || '[]');
  ids.push(id);
  PropertiesService.getScriptProperties().setProperty('ST_INDEX', JSON.stringify(ids));
  saveSt_(st);
  return st;
}

function listSt_() { return JSON.parse(prop_('ST_INDEX') || '[]').map(getSt_).filter(Boolean); }
function getSt_(id) { const raw = prop_('ST_' + id); return raw ? JSON.parse(raw) : null; }
function saveSt_(st) { PropertiesService.getScriptProperties().setProperty('ST_' + st.id, JSON.stringify(st)); }
function findByKey_(key) { return key ? listSt_().find(st => st.key === key) || null : null; }
function root_(st) { return DriveApp.getFolderById(st.folderId); }
function doneToday_(st, date) { return ((st.answered || {})[date || localDate_(st)]) || 0; }
function dayIndex_(st) { return Math.max(0, daysBetween_(st.start || localDate_(st), localDate_(st))); }
function localDate_(st) { return Utilities.formatDate(new Date(), st.tz || Session.getScriptTimeZone(), 'yyyy-MM-dd'); }

function publicProfile_(st) {
  return { id: st.id, name: st.name, callName: st.callName, email: st.email || '', uiLang: st.uiLang,
           langs: st.langs || [], mode: st.mode, perDay: st.perDay, hours: st.hours, tz: st.tz,
           start: st.start, defaultKind: st.defaultKind || 'video', progress: st.progress || 0,
           extraDone: st.extraDone || 0 };
}

function applyAdminFields_(st, f) {
  if (f.name) st.name = String(f.name).slice(0, 40);
  if (f.callName) st.callName = String(f.callName).slice(0, 20);
  if (UI_LANGS.indexOf(f.uiLang) >= 0) st.uiLang = f.uiLang;
  if (Array.isArray(f.langs)) st.langs = f.langs.filter((l, i, a) => LANGS.indexOf(l) >= 0 && a.indexOf(l) === i);
  if (f.mode === 'daily' || f.mode === 'each') st.mode = f.mode;
  if (f.defaultKind === 'video' || f.defaultKind === 'audio') st.defaultKind = f.defaultKind;
  if (f.email !== undefined) st.email = String(f.email).trim().toLowerCase();
  if (PER_DAY.indexOf(Number(f.perDay)) >= 0) st.perDay = Number(f.perDay);
  if (f.hours) {
    const hrs = String(f.hours).split(/[,\s]+/).map(Number).filter(h => h >= 0 && h <= 23);
    if (hrs.length) st.hours = hrs;
  }
  if (!st.hours || st.hours.length < st.perDay) st.hours = DEFAULT_HOURS[st.perDay].slice();
  if (f.tz && validTz_(String(f.tz).trim())) st.tz = String(f.tz).trim();
  if (f.followUps !== undefined) st.followUps = f.followUps === true || f.followUps === 'on';
  if (f.family !== undefined) {
    st.family = String(f.family).split(/[,\s;]+/).filter(e => /@/.test(e));
    st.family.forEach(email => {
      try { root_(st).addViewer(email); } catch (err) {}
      // the question Sheet needs edit rights so the family can add questions
      try { if (st.sheetId) DriveApp.getFileById(st.sheetId).addEditor(email); } catch (err) {}
    });
  }
}

/** "Asia/Ho_Chi_Minh", "America/Chicago", "UTC". Java silently turns unknown names (e.g. "Central US") into GMT. */
function validTz_(tz) { return /^(UTC|GMT|[A-Za-z]+(\/[A-Za-z0-9_+-]+)+)$/.test(tz); }

function rand_() { return Utilities.getUuid().replace(/-/g, '').slice(0, 8); }
function addDays_(st, days) {
  return Utilities.formatDate(new Date(Date.now() + days * 86400000), st.tz || Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

function ticket_(folderId, name) {
  DriveApp.getRootFolder(); // keeps the Drive scope in the token
  return { token: ScriptApp.getOAuthToken(), folderId, name };
}

function promptData_(id, lang) {
  const fid = prop_(`P_${id}_${lang}`);
  if (!fid) return null;
  try {
    const blob = DriveApp.getFileById(fid).getBlob();
    return { mime: blob.getContentType(), b64: Utilities.base64Encode(blob.getBytes()) };
  } catch (err) { return null; }
}

function fillVi_(s, callName) {
  const c = callName || 'bạn';
  return s.replace(/\{X\}/g, c.charAt(0).toUpperCase() + c.slice(1))
          .replace(/\{x\}/g, c.charAt(0).toLowerCase() + c.slice(1));
}

function cleanId_(id) { return String(id).replace(/[^\w]/g, ''); }
function mmss_(s) { s = Number(s) || 0; return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; }
function safeExt_(e) { return /^(m4a|mp4|webm|aac|ogg|wav)$/.test(e) ? e : 'mp4'; }
function daysBetween_(a, b) { return Math.round((new Date(b + 'T00:00:00Z') - new Date(a + 'T00:00:00Z')) / 86400000); }
function prop_(k) { return PropertiesService.getScriptProperties().getProperty(k); }
function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }

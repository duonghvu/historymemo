# Copy to .env.local for `npm run dev`, and add the same values in Vercel → Settings → Environment Variables.
# Never commit real values. (`npm run dev:mock` needs none of these.)

# Google Apps Script web app (README Step 2)
GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec
GAS_SECRET=from-apps-script-setup-log

# "Sign in with Google" (README Step 3): OAuth client ID from Google Cloud Console
GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Who can open /admin.html: Google emails, comma separated (and/or a fallback key)
ADMIN_EMAILS=you@gmail.com
ADMIN_KEY=change-me-long-random
SESSION_SECRET=another-long-random-string

# Notifications (npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@gmail.com
